<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" href="data:image/jpeg;base64,"><link rel="apple-touch-icon" href="data:image/jpeg;base64,"><meta name="apple-mobile-web-app-title" content="Boutique"><title>Boutique – Plan des rayons</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:system-ui,sans-serif;background:#0d0d0d;color:#eee;color-scheme:dark}
header{position:sticky;top:0;z-index:5;background:#000;border-bottom:1px solid #333;color:#fff;padding:10px;display:flex;gap:8px;flex-wrap:wrap}
header input{flex:1;min-width:140px;padding:10px;border-radius:8px;border:1px solid #444;background:#1e1e1e;color:#fff;font-size:16px}
button{padding:10px 12px;border:0;border-radius:8px;background:#e8a020;font-size:15px;font-weight:600}
button.sec{background:#2c2c2c;color:#eee}
button.danger{background:#d9534f;color:#fff}
#plan{width:100%;max-height:62vh;background:#0d0d0d;display:block}
.rayon{cursor:pointer}
.rayon .body{stroke:#333;stroke-width:3}
.rayon text{font-size:24px;font-weight:700;text-anchor:middle;dominant-baseline:central;pointer-events:none;fill:#000}
.rayon text.badge{stroke:none}
.rayon.sel .body{stroke:#e8a020;stroke-width:10}
.rayon.hit .body{stroke:#2e9e4f;stroke-width:10}
.rayon.alert .body{stroke:#d9534f;stroke-width:8}
.badge{font-size:20px;fill:#fff;font-weight:700}
#panel,#res{background:#1a1a1a;border:1px solid #2c2c2c;margin:8px;padding:12px;border-radius:12px}
h2{margin:0 0 8px;font-size:18px}
.p{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 0;border-top:1px solid #333}
.p small{color:#aaa;display:block}
.low{color:#ff6b66;font-weight:700}
dialog{border:1px solid #333;background:#1a1a1a;color:#eee;border-radius:12px;width:min(92vw,420px);padding:16px}
dialog label{display:block;margin:8px 0 2px;font-size:14px}
dialog input,dialog select{width:100%;padding:9px;font-size:16px;border:1px solid #555;background:#262626;color:#fff;border-radius:8px}
.row{display:flex;gap:8px;margin-top:12px}
.row button{flex:1}
</style>
</head>
<body>
<header>
  <img src="data:image/jpeg;base64," alt="Logo" style="height:42px;border-radius:6px;background:#fff;padding:2px" onerror="this.remove()">
  <input id="q" type="search" placeholder="Chercher un produit ou un code-barres…">
  <button id="bScan">📷 Scan</button>
  <button id="bSans" class="sec">📦 Sans rayon</button>
  <button id="bAlert">⚠ Alertes</button>
  <button id="bHist" class="sec">Historique</button>
  <button id="bSave" class="sec">Sauvegarde</button>
</header>
<svg id="plan" viewBox="400 90 1130 1360"></svg>
<div id="res" hidden></div>
<div id="panel"><h2>Touchez un rayon sur le plan</h2></div>

<dialog id="dlg">
  <form method="dialog" id="f">
    <h2 id="ft">Produit</h2>
    <label>Nom</label><input name="nom" required>
    <label>Code-barres</label><input name="code" inputmode="numeric">
    <button type="button" class="sec" id="fScan" style="margin-top:6px;width:100%">📷 Scanner le code</button>
    <label>Catégorie</label><input name="cat">
    <label>Prix</label><input name="prix" type="number" step="any" min="0">
    <label>Quantité en stock</label><input name="qte" type="number" min="0" value="0">
    <label>Alerte si stock ≤</label><input name="seuil" type="number" min="0" value="3">
    <label>Date de péremption</label><input name="per" type="date">
    <label>Rayon</label><select name="rayon"></select>
    <div class="row">
      <button type="button" class="sec" id="cancel">Annuler</button>
      <button type="submit">Enregistrer</button>
    </div>
    <div class="row"><button type="button" class="danger" id="del" hidden>Supprimer</button></div>
  </form>
</dialog>

<dialog id="dmv">
  <form method="dialog" id="fm">
    <h2 id="mt"></h2>
    <label>Quantité</label><input name="q" type="number" min="1" value="1" required>
    <label>Motif</label><select name="m"></select>
    <div class="row"><button type="button" class="sec" id="mcancel">Annuler</button><button type="submit">Valider</button></div>
  </form>
</dialog>

<dialog id="dscan">
  <h2>Scanner un code-barres</h2>
  <video id="vid" playsinline muted style="width:100%;border-radius:8px;background:#000"></video>
  <p id="smsg"></p>
  <div class="row"><button class="sec" id="sclose">Fermer</button></div>
</dialog>

<dialog id="dsave">
  <h2>Sauvegarde</h2>
  <div class="row"><button id="exp">Exporter</button><button id="imp" class="sec">Importer</button></div>
  <div class="row"><button id="seed" class="sec">Charger la base de produits</button></div>
  <div class="row"><button id="rng" class="sec">Ranger les produits sans rayon</button></div>
  <input type="file" id="file" accept=".json" hidden>
  <div class="row"><button class="sec" onclick="dsave.close()">Fermer</button></div>
</dialog>

