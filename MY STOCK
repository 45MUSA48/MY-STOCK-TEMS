// Décodeur EAN-13 / EAN-8 (UPC-A inclus) pour les navigateurs sans BarcodeDetector (iPhone)
const LP=["3211","2221","2122","1411","1132","1231","1114","1312","1213","3112"].map(x=>[...x].map(Number));
const GP=["1123","1222","2212","1141","2311","1321","4111","2131","3121","2113"].map(x=>[...x].map(Number));
const PAR=["LLLLLL","LLGLGG","LLGGLG","LLGGGL","LGLLGG","LGGLLG","LGGGLL","LGLGLG","LGLGGL","LGGLGL"];
function matchDigit(w,sets){
  const t=w[0]+w[1]+w[2]+w[3],k=7/t;let best=null;
  for(const s of sets)for(let d=0;d<10;d++){
    let e=0;for(let i=0;i<4;i++){const x=w[i]*k-s.p[d][i];e+=x*x;}
    if(!best||e<best.e)best={d,t:s.t,e};
  }
  return best&&best.e<0.7?best:null;
}
function eanAt(runs,i,n){
  const half=n==13?6:4,need=3+half*4+5+half*4+3;
  if(i+need>runs.length)return null;
  const m=(runs[i]+runs[i+1]+runs[i+2])/3;
  if(m<1)return null;
  if(i<1||runs[i-1]<5*m)return null;
  for(let j=0;j<3;j++)if(Math.abs(runs[i+j]/m-1)>0.5)return null;
  let p=i+3;const ds=[];let par="";
  for(let k=0;k<half;k++,p+=4){
    const r=matchDigit(runs.slice(p,p+4),n==13?[{p:LP,t:"L"},{p:GP,t:"G"}]:[{p:LP,t:"L"}]);
    if(!r)return null;ds.push(r.d);par+=r.t;
  }
  for(let j=0;j<5;j++)if(Math.abs(runs[p+j]/m-1)>0.6)return null;
  p+=5;
  for(let k=0;k<half;k++,p+=4){
    const r=matchDigit(runs.slice(p,p+4),[{p:LP,t:"L"}]);
    if(!r)return null;ds.push(r.d);
  }
  if(n==13){const f=PAR.indexOf(par);if(f<0)return null;ds.unshift(f);}
  if(p+3<runs.length&&runs[p+3]<5*m)return null;
  const body=ds.length-1;let sum=0;
  for(let j=0;j<body;j++)sum+=ds[j]*((n==13?j%2:(j+1)%2)?3:1);
  if(n==8){sum=0;for(let j=0;j<7;j++)sum+=ds[j]*(j%2?1:3);}
  if((10-sum%10)%10!=ds[body])return null;
  return ds.join("");
}
function runsOf(g){
  const n=g.length,pre=new Float64Array(n+1);
  for(let i=0;i<n;i++)pre[i+1]=pre[i]+g[i];
  const W=Math.max(16,n>>3),runs=[];let cur=null,len=0,first=null;
  for(let x=0;x<n;x++){
    const a=Math.max(0,x-W),b=Math.min(n,x+W),m=(pre[b]-pre[a])/(b-a);
    const dark=g[x]<m*0.95;
    if(cur===null){cur=dark;first=dark;len=1;}
    else if(dark===cur)len++;
    else{runs.push(len);cur=dark;len=1;}
  }
  runs.push(len);return {runs,first};
}
function decodeLine(g){
  for(const arr of [g,Float32Array.from(g).reverse()]){
    const {runs,first}=runsOf(arr);
    for(let i=0;i<runs.length-42;i++){
      if((i%2==0)!==first)continue;
      const r=eanAt(runs,i,13)||eanAt(runs,i,8);
      if(r)return r;
    }
  }
  return null;
}
function decodeFrame(ctx,w,h){
  const img=ctx.getImageData(0,0,w,h).data;
  for(let k=0;k<17;k++){
    const y=Math.min(h-3,Math.max(2,Math.floor(h*(0.25+0.5*k/16))));
    const g=new Float32Array(w);
    for(let x=0;x<w;x++){
      let s=0;
      for(let dy=-2;dy<=2;dy++){const o=((y+dy)*w+x)*4;s+=img[o]*0.3+img[o+1]*0.59+img[o+2]*0.11;}
      g[x]=s/5;
    }
    const r=decodeLine(g);if(r)return r;
  }
  return null;
}

let stream=null,scanTimer=null,scanMode="find";
async function startScan(mode){
  scanMode=mode;$("#smsg").textContent="";
  $("#dscan").showModal();
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){
    $("#smsg").textContent="Caméra non disponible ici. Ouvrez l'application depuis une adresse https, ou tapez le code dans la recherche.";return;}
  try{
    const det="BarcodeDetector" in window?new BarcodeDetector({formats:["ean_13","ean_8","upc_a","upc_e","code_128","code_39","qr_code"]}):null;
    stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:"environment",width:{ideal:1280},height:{ideal:720}}});
    const v=$("#vid");v.setAttribute("playsinline","");v.muted=true;v.srcObject=stream;await v.play();
    $("#smsg").textContent="Placez le code-barres à plat devant la caméra, bien éclairé…";
    const cv=document.createElement("canvas"),cx=cv.getContext("2d",{willReadFrequently:true});
    let last=null,n=0;
    scanTimer=setInterval(async()=>{
      try{
        let code=null;
        if(det){const r=await det.detect(v);if(r.length)code=r[0].rawValue;}
        else if(v.videoWidth){
          const w=Math.min(960,v.videoWidth),h=Math.round(w*v.videoHeight/v.videoWidth);
          cv.width=w;cv.height=h;cx.drawImage(v,0,0,w,h);code=decodeFrame(cx,w,h);
        }
        if(code){
          if(det||code===last)n++;else{last=code;n=1;}
          if(det||n>=2){$("#dscan").close();onCode(code);}
        }
      }catch{}
    },det?300:150);
  }catch(err){$("#smsg").textContent="Caméra inaccessible : autorisez l'accès à la caméra pour ce site.";}
}
function stopScan(){clearInterval(scanTimer);if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}}
$("#dscan").addEventListener("close",stopScan);
$("#sclose").onclick=()=>$("#dscan").close();
const CAT=JSON.parse(localStorage.getItem("catalogue")||"{}");
async function lookup(code){
  if(CAT[code])return CAT[code];
  try{
    const c=new AbortController();setTimeout(()=>c.abort(),7000);
    const r=await fetch("https://world.openfoodfacts.org/api/v2/product/"+encodeURIComponent(code)+".json?fields=product_name,product_name_fr,brands,categories,quantity",{signal:c.signal});
    const j=await r.json();
    if(j.status!==1||!j.product)return null;
    const q=j.product;let nom=q.product_name_fr||q.product_name||"";
    const br=(q.brands||"").split(",")[0].trim();
    if(nom&&br&&!nom.toLowerCase().includes(br.toLowerCase()))nom+=" "+br;
    if(nom&&q.quantity)nom+=" "+q.quantity;
    if(!nom)return null;
    const info={nom:nom.trim(),cat:(q.categories||"").split(",")[0].trim()};
    CAT[code]=info;try{localStorage.setItem("catalogue",JSON.stringify(CAT));}catch{}
    return info;
  }catch{return null;}
}
async function fillForm(code){
  const f=$("#f");
  if(!code||f.nom.value.trim())return;
  $("#ft").textContent="Recherche du produit…";
  const info=await lookup(code);
  if(info&&!f.nom.value.trim()){f.nom.value=info.nom;if(!f.cat.value)f.cat.value=info.cat;}
  $("#ft").textContent=info?"Produit trouvé : vérifiez et enregistrez":"Produit non trouvé en ligne : à remplir";
}
$("#f").code.addEventListener("change",e=>fillForm(e.target.value.trim()));
async function onCode(code){
  if(scanMode=="form"){$("#f").code.value=code;fillForm(code);return;}
  const nz=x=>String(x||"").replace(/^0+/,"");
  const l=P.filter(p=>p.code&&nz(p.code)==nz(code));
  if(l.length){hits=[...new Set(l.map(p=>p.rayon))];sel=l[0].rayon;showRes(l,"Code "+code);render();window.scrollTo(0,0);return;}
  askAssoc(code);
}
let pending=null;const DEFPH="Chercher un produit ou un code-barres…";
function newFromCode(code){
  openForm(null);
  const f=$("#f");f.code.value=code;if(!f.rayon.value)f.rayon.value=0;
  fillForm(code);
}
function askAssoc(code){
  pending=code;
  const el=$("#res");el.hidden=false;
  el.innerHTML=`<h2>Code ${code} inconnu</h2><p>Tapez le nom du produit dans la barre de recherche pour lui associer ce code, ou créez un nouveau produit.</p><div class="row"><button id="aNew">Nouveau produit</button><button class="sec" id="aCancel">Annuler</button></div>`;
  const q=$("#q");q.value="";q.placeholder="Nom du produit à associer…";q.focus();
  $("#aNew").onclick=()=>{pending=null;q.placeholder=DEFPH;showRes([],null);newFromCode(code);};
  $("#aCancel").onclick=()=>{pending=null;q.placeholder=DEFPH;showRes([],null);};
}
$("#bScan").onclick=()=>startScan("find");
$("#fScan").onclick=()=>startScan("form");
const PAL=["#e63946","#f4a261","#2a9d8f","#457b9d","#ffd166","#8338ec","#06d6a0","#ef476f"];
function body(r){
  const [n,nom,t,x,y,w,h,c]=r;
  let s=`<rect class="body" x="${x}" y="${y}" width="${w}" height="${h}" rx="4" fill="${c}" filter="url(#sh)"/>`;
  if(t=="frigo"){
    const horiz=w>=h,k=Math.max(1,Math.round((horiz?w:h)/(horiz?75:84)));
    for(let i=0;i<k;i++){
      const gx=horiz?x+4+i*(w-8)/k:x+4,gy=horiz?y+4:y+4+i*(h-8)/k;
      const gw=horiz?(w-8)/k-3:w-8,gh=horiz?h-8:(h-8)/k-3;
      s+=`<rect x="${gx}" y="${gy}" width="${gw}" height="${gh}" rx="3" fill="url(#glass)" stroke="#456" stroke-width="1.5"/>`;
      s+=horiz?`<line x1="${gx+gw-5}" y1="${gy+4}" x2="${gx+gw-5}" y2="${gy+gh-4}" stroke="#fff" stroke-width="3"/>`
               :`<line x1="${gx+4}" y1="${gy+gh-5}" x2="${gx+gw-4}" y2="${gy+gh-5}" stroke="#fff" stroke-width="3"/>`;
    }
  }else if(t=="meuble"){
    const k=Math.max(2,Math.round(w/75)),pw=(w-10)/k;
    s+=`<rect x="${x+3}" y="${y+3}" width="${w-6}" height="${h-6}" rx="3" fill="url(#wood)"/>`;
    for(let i=0;i<k;i++){const px=x+5+i*pw;
      s+=`<rect x="${px}" y="${y+6}" width="${pw-3}" height="${h-12}" rx="2" fill="none" stroke="#8a6a38" stroke-width="2"/><circle cx="${px+pw/2-1}" cy="${y+h-14}" r="4" fill="#5b4220"/>`;}
  }else if(t=="gondole"){
    const hh=h/2-8;
    for(const yy of [y+5,y+h/2+3])
      for(let i=x+16,j=0;i<x+w-26;i+=15,j++)
        s+=`<rect x="${i}" y="${yy}" width="11" height="${hh}" rx="2" fill="${PAL[(j*3+n)%PAL.length]}"/>`;
    s+=`<rect x="${x}" y="${y}" width="12" height="${h}" rx="3" fill="#777"/><rect x="${x+w-12}" y="${y}" width="12" height="${h}" rx="3" fill="#777"/>`;
  }else{
    if(w>=h){for(let i=x+8,j=0;i<x+w-14;i+=13,j++)s+=`<rect x="${i}" y="${y+5}" width="9" height="${h-10}" rx="2" fill="${PAL[(j*5+n)%PAL.length]}" opacity=".55"/>`;}
    else{for(let i=y+8,j=0;i<y+h-14;i+=13,j++)s+=`<rect x="${x+5}" y="${i}" width="${w-10}" height="9" rx="2" fill="${PAL[(j*5+n)%PAL.length]}" opacity=".55"/>`;}
  }
  return s;
}
function drawPlan(){
  let s=`<defs>
<pattern id="tile" width="60" height="60" patternUnits="userSpaceOnUse"><rect width="60" height="60" fill="#232323"/><path d="M60 0H0V60" fill="none" stroke="#303030" stroke-width="2"/></pattern>
<linearGradient id="glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e8f6fb"/><stop offset=".5" stop-color="#9fd3e6"/><stop offset="1" stop-color="#6fb3cf"/></linearGradient>
<linearGradient id="wood" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e2c48d"/><stop offset="1" stop-color="#c49a5c"/></linearGradient>
<filter id="sh" x="-10%" y="-10%" width="125%" height="135%"><feDropShadow dx="3" dy="4" stdDeviation="3" flood-opacity=".35"/></filter>
</defs>
<rect x="400" y="90" width="1130" height="1360" fill="#121212"/>
<rect x="520" y="118" width="880" height="1305" fill="url(#tile)"/>
<rect x="520" y="118" width="880" height="1305" fill="none" stroke="#777" stroke-width="12"/>
<g fill="none" stroke="#999" stroke-width="3">
<path d="M420 118V218M420 218A100 100 0 0 1 520 118"/>
<path d="M420 1345V1425M420 1345A100 100 0 0 0 520 1425"/>
<path d="M1400 1160H1510M1400 1370H1510M1510 1160A110 110 0 0 1 1400 1270M1510 1370A110 110 0 0 0 1400 1260"/>
</g>`;
  for(const d of DECOR){
    s+=`<rect x="${d[3]}" y="${d[4]}" width="${d[5]}" height="${d[6]}" rx="4" fill="url(#wood)" stroke="#8a6a38" stroke-width="2" filter="url(#sh)"/>`;
    if(d[2]=="table")s+=`<circle cx="${d[3]+d[5]/2}" cy="${d[4]+d[6]/2}" r="${d[6]*0.6}" fill="#7a8794" stroke="#4a5560" stroke-width="2"/>`;
  }
  for(const d of DECO2)s+=`<g>${body(d)}</g>`;
  for(const r of R){
    const [n,nom,t,x,y,w,h,c]=r;
    const ps=P.filter(p=>p.rayon==n);
    const cls=["rayon"];
    if(sel==n)cls.push("sel");
    if(hits.includes(n))cls.push("hit");
    if(ps.some(isAlert))cls.push("alert");
    s+=`<g class="${cls.join(" ")}" data-n="${n}">${body(r)}<circle cx="${x+w/2}" cy="${y+h/2}" r="20" fill="#fff" fill-opacity=".92" stroke="#333" stroke-width="2"/>`+
       `<text x="${x+w/2}" y="${y+h/2}">${n}</text>`;
    if(ps.length)s+=`<circle cx="${x+w-8}" cy="${y+8}" r="15" fill="#1f3a5f"/><text class="badge" x="${x+w-8}" y="${y+8}" style="fill:#fff;font-size:20px">${ps.length}</text>`;
    s+="</g>";
  }
  $("#plan").innerHTML=s;
}
$("#plan").addEventListener("click",e=>{
  const g=e.target.closest(".rayon");
  if(g){sel=+g.dataset.n;hits=[];render();}
});

function panel(){
  if(sel===null){$("#panel").innerHTML="<h2>Touchez un rayon sur le plan</h2>";return;}
  const r=rr(sel),ps=P.filter(p=>p.rayon==sel);
  $("#panel").innerHTML=`<h2>${sel===0?"Produits sans rayon ("+ps.length+")":"Rayon "+r[0]+" – "+r[1]}</h2>${DESC[r[0]]&&sel!==0?"<p style=\"margin:0 0 8px;color:#aaa\">"+DESC[r[0]]+"</p>":""}<button id="add">+ Produit</button>`+
    (ps.length?ps.map(p=>`<div class="p" data-id="${p.id}"><div><b>${p.nom}</b>
      <small>${p.cat||""}${p.ref?" · Réf "+p.ref:""}${p.code?" · "+p.code:""}</small>
      <small>${p.prix!==""?p.prix+" · ":""}<span class="${isLow(p)?"low":""}">Stock : ${p.qte}</span>${p.per?" · Péremption : "+p.per:""}</small></div>
      <div style="display:flex;gap:6px"><button class="sec" data-mv="${p.id}" data-s="-1">−</button><button data-mv="${p.id}" data-s="1">+</button><button class="sec" data-edit="${p.id}">✎</button></div></div>`).join(""):"<p>Aucun produit dans ce rayon.</p>");
  $("#add").onclick=()=>openForm(null);
  document.querySelectorAll("[data-edit]").forEach(b=>b.onclick=()=>openForm(b.dataset.edit));
  document.querySelectorAll("[data-mv]").forEach(b=>b.onclick=()=>openMv(b.dataset.mv,+b.dataset.s));
}
function render(){drawPlan();panel();}

function openForm(id){
  edit=id?P.find(p=>p.id==id):null;
  const f=$("#f");
  f.rayon.innerHTML='<option value="0">0 – Sans rayon</option>'+R.map(r=>`<option value="${r[0]}">${r[0]} – ${r[1]}</option>`).join("");
  const p=edit||{nom:"",code:"",cat:"",prix:"",qte:0,seuil:3,per:"",rayon:sel};
  for(const k of ["nom","code","cat","prix","qte","seuil","per","rayon"])f[k].value=p[k]??"";
  $("#ft").textContent=edit?"Modifier le produit":"Nouveau produit";
  $("#del").hidden=!edit;
  $("#dlg").showModal();
}
$("#f").addEventListener("submit",()=>{
  const f=$("#f");
  const d={nom:f.nom.value.trim(),code:f.code.value.trim(),cat:f.cat.value.trim(),prix:f.prix.value,qte:+f.qte.value,seuil:+f.seuil.value,per:f.per.value,rayon:+f.rayon.value};
  if(edit)Object.assign(edit,d);else P.push({id:Date.now().toString(36),...d});
  save();sel=d.rayon;render();
});
$("#cancel").onclick=()=>$("#dlg").close();
$("#del").onclick=()=>{if(confirm("Supprimer ce produit ?")){P=P.filter(p=>p!==edit);save();$("#dlg").close();render();}};

function showRes(list,title){
  const el=$("#res");
  if(title===null){el.hidden=true;return;}
  el.hidden=false;
  el.innerHTML=`<h2>${title}</h2>`+(list.length?list.map(p=>`<div class="p" data-go="${p.rayon}"><div><b>${p.nom}</b>
    <small>Rayon ${p.rayon} – ${rr(p.rayon)[1]} · Stock : ${p.qte}${p.per?" · "+p.per:""}</small></div><button class="sec">Voir</button></div>`).join(""):"<p>Aucun résultat.</p>");
  el.querySelectorAll("[data-go]").forEach(d=>d.onclick=()=>{sel=+d.dataset.go;hits=[sel];render();window.scrollTo(0,0);});
}
$("#q").addEventListener("input",e=>{
  const v=e.target.value.trim().toLowerCase();
  if(pending){
    const l=v?P.filter(p=>(p.nom+" "+(p.ref||"")).toLowerCase().includes(v)).slice(0,20):[];
    const el=$("#res");el.hidden=false;
    el.innerHTML=`<h2>Associer le code ${pending}</h2>`+(l.length?l.map(p=>`<div class="p"><div><b>${p.nom}</b><small>Réf ${p.ref||"-"} · Stock ${p.qte}</small></div><button data-as="${p.id}">Associer</button></div>`).join(""):"<p>Tapez le nom du produit…</p>");
    el.querySelectorAll("[data-as]").forEach(b=>b.onclick=()=>{
      const p=P.find(x=>x.id==b.dataset.as);
      if(p.code&&!confirm("Ce produit a déjà un code ("+p.code+"). Le remplacer ?"))return;
      p.code=pending;pending=null;save();$("#q").value="";$("#q").placeholder=DEFPH;
      sel=p.rayon;hits=[p.rayon];showRes([p],"Code associé");render();
    });
    return;
  }
  if(!v){hits=[];showRes([],null);render();return;}
  const l=P.filter(p=>(p.nom+" "+p.code+" "+(p.ref||"")+" "+p.cat).toLowerCase().includes(v));
  hits=[...new Set(l.map(p=>p.rayon))];
  showRes(l,`Résultats (${l.length})`);render();
});
$("#bAlert").onclick=()=>{const l=P.filter(isAlert);hits=[...new Set(l.map(p=>p.rayon))];showRes(l,`Alertes (${l.length}) : stock bas ou péremption sous 7 jours`);render();};

$("#bSans").onclick=()=>{sel=0;hits=[];showRes([],null);render();};
$("#seed").onclick=()=>{const a=seedBase();render();$("#dsave").close();alert(a+" produit(s) ajouté(s) dans « Sans rayon ».");};
$("#rng").onclick=()=>{const a=autoRange();render();$("#dsave").close();alert(a+" produit(s) rangé(s) dans leur rayon.");};
$("#bSave").onclick=()=>$("#dsave").showModal();
$("#exp").onclick=()=>{
  const a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob([JSON.stringify({produits:P,mouvements:M},null,1)],{type:"application/json"}));
  a.download="produits-boutique.json";a.click();
};
$("#imp").onclick=()=>$("#file").click();
$("#file").onchange=async e=>{
  try{const d=JSON.parse(await e.target.files[0].text());const pr=Array.isArray(d)?d:d.produits;if(Array.isArray(pr)){P=pr;if(Array.isArray(d.mouvements)){M=d.mouvements;saveM();}save();render();$("#dsave").close();}}
  catch{alert("Fichier invalide");}
};
if("serviceWorker" in navigator)navigator.serviceWorker.register("sw.js").catch(()=>{});
render();
</script>
</body>
</html>
